# Backend/APIService env example
# Existing workspace keys (already present in .env for preview):
# REACT_APP_LOG_LEVEL=info
# REACT_APP_FRONTEND_URL=http://localhost:3000

# Server metrics pipeline configuration (preferred keys)
METRICS_POLL_INTERVAL_MS=1000
METRICS_CACHE_HOURS=24
METRICS_MAX_STREAMS=8

# Optional overrides using workspace-style keys (supported but not required)
# REACT_APP_METRICS_POLL_INTERVAL_MS=1000
# REACT_APP_METRICS_CACHE_HOURS=24
# REACT_APP_METRICS_MAX_STREAMS=8
